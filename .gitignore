# ==============================================================================
# .gitignore - THE 27 CLUB CTF (Limpieza de Repositorio de Práctica)
# ==============================================================================

# Informes y documentos de entrega académica (no necesarios para ejecutar la práctica)
*.docx
*.doc
*.pdf
*.pptx
Laboratorios/

# Carpeta de capturas de pantalla de evidencias (solo para el informe escrito)
capturas/

# Scripts de generación interna y utilitarios auxiliares
*.py
inspect_*.py
dump_*.py
format_*.py
download_*.py
fetch_*.py
map_*.py
extract_*.py
*.json

# Scripts de aprovisionamiento obsoletos/duplicados
provision_27club_phases.ps1
setup_fase3.*
dashboard/

# Archivos de respaldo y temporales
*.tmp
*.bak
~$*.*
.DS_Store
Thumbs.db

# Entornos virtuales y cachés de Python
__pycache__/
*.pyc

# Logs
*.log
